<%- include("partials/header") %>

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-default mb-1">Beérkezett üzenetek</h1>
    <p class="text-sm text-subtle mb-0">Fordított időrendben megjelenítve (a legfrissebb üzenet van elöl).</p>
</div>

<div class="card">
    <div class="mozi-table-wrap">
        <table class="mozi-table">
            <thead>
                <tr>
                    <th>Küldés ideje</th>
                    <th>Küldő neve</th>
                    <th>E-mail</th>
                    <th>Tárgy</th>
                    <th>Üzenet</th>
                </tr>
            </thead>
            <tbody>
                <% if (messages.length === 0) { %>
                    <tr><td colspan="5">Még nem érkezett üzenet.</td></tr>
                <% } %>
                <% messages.forEach(msg => { %>
                    <tr>
                        <td style="white-space: nowrap;">
                            <%= new Date(msg.createdAt).toLocaleString("hu-HU", {
                                year: "numeric", month: "2-digit", day: "2-digit",
                                hour: "2-digit", minute: "2-digit"
                            }) %>
                        </td>
                        <td><strong class="text-default"><%= msg.name %></strong></td>
                        <td><%= msg.email %></td>
                        <td><%= msg.subject %></td>
                        <td><%= msg.text %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include("partials/footer") %>
