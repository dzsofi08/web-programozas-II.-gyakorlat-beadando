<%- include("partials/header") %>

<div class="mx-auto max-w-xl">
    <div class="card">
        <div class="card-body sm:p-8">
            <h1 class="text-2xl font-semibold text-default mb-1">Kapcsolatfelvétel</h1>
            <p class="text-sm text-subtle mb-6">Küldjön üzenetet az oldal tulajdonosának! A mezők szerver oldalon ellenőrzésre kerülnek.</p>

            <% if (errors && errors.length > 0) { %>
                <div class="alert-box alert-error">
                    <ul class="mb-0 ps-4">
                        <% errors.forEach(err => { %>
                            <li><%= err %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form method="POST" action="/kapcsolat" class="space-y-4" novalidate>
                <div class="form-field">
                    <label for="name" class="form-label text-subtle">Név *</label>
                    <input type="text" id="name" name="name" class="form-control" value="<%= formData.name || '' %>" placeholder="Teljes név">
                </div>
                <div class="form-field">
                    <label for="email" class="form-label text-subtle">E-mail cím *</label>
                    <input type="email" id="email" name="email" class="form-control" value="<%= formData.email || '' %>" placeholder="pelda@email.hu">
                </div>
                <div class="form-field">
                    <label for="subject" class="form-label text-subtle">Tárgy *</label>
                    <input type="text" id="subject" name="subject" class="form-control" value="<%= formData.subject || '' %>" placeholder="Üzenet tárgya">
                </div>
                <div class="form-field">
                    <label for="text" class="form-label text-subtle">Üzenet *</label>
                    <textarea id="text" name="text" rows="5" class="form-control" placeholder="Írja ide üzenetét (legalább 10 karakter)..."><%= formData.text || '' %></textarea>
                </div>
                <button type="submit" class="btn btn-gradient w-full">Üzenet küldése</button>
            </form>
        </div>
    </div>
</div>

<%- include("partials/footer") %>
